---
interface Props {
  title?: string;
  message?: string;
}

const {
  title = 'No charts yet',
  message = 'The first chart is in the works. Check back soon.',
} = Astro.props;
---

<div class="empty-state">
  <svg viewBox="0 0 112 72" aria-hidden="true">
    <line x1="4" y1="20" x2="108" y2="20" stroke="var(--grid)"></line>
    <line x1="4" y1="42" x2="108" y2="42" stroke="var(--grid)"></line>
    <rect x="14" y="44" width="16" height="20" rx="3" fill="var(--grid)"></rect>
    <rect x="36" y="30" width="16" height="34" rx="3" fill="var(--grid)"></rect>
    <rect x="58" y="38" width="16" height="26" rx="3" fill="var(--grid)"></rect>
    <rect x="80" y="14" width="16" height="50" rx="3" fill="var(--accent)"></rect>
    <line x1="4" y1="64.5" x2="108" y2="64.5" stroke="var(--text-secondary)"></line>
  </svg>
  <h2>{title}</h2>
  <p>{message}</p>
</div>
